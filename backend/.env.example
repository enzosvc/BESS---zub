# URL do projeto Supabase (Settings > API > Project URL)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Service role key (Settings > API > service_role secret) — NUNCA exponha no frontend
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# JWT secret do projeto (Settings > API > JWT Settings > JWT Secret) — usado para
# validar os tokens de login que o frontend manda em cada requisição
SUPABASE_JWT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL exata do frontend em produção (restringe o CORS); use "*" só em desenvolvimento
FRONTEND_ORIGIN=https://seu-app.vercel.app
