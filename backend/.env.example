# URL do projeto Supabase (Settings > API > Project URL)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Service role key (Settings > API > service_role secret) — NUNCA exponha no frontend
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# NOTA: não precisamos mais de SUPABASE_JWT_SECRET — desde out/2025, projetos novos da
# Supabase assinam os tokens de sessão com um par de chaves assimétrico, e o backend
# valida contra a chave PÚBLICA do projeto (buscada automaticamente via JWKS a partir
# da SUPABASE_URL acima, ver app/auth.py). Nada sensível a guardar aqui.

# URL exata do frontend em produção (restringe o CORS); use "*" só em desenvolvimento
FRONTEND_ORIGIN=https://seu-app.vercel.app
